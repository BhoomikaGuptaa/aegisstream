# AegisStream Environment Configuration
# Copy to .env and adjust as needed

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# Database (SQLite by default; use sqlite:///path/to/file.db)
DATABASE_URL=/data/aegisstream.db

# Producer configuration
EVENTS_PER_SECOND=5
DRIFT_ENABLED=true
DRIFT_START_EVENT=500
INJECTION_RATE=0.04
HALLUCINATION_RATE=0.08

# Deployment gate defaults (used by scripts/deployment_gate.py)
GATE_MAX_REVIEW_RATE=15.0
GATE_MAX_RISK_SCORE=35.0
GATE_MAX_P95_LATENCY=3000.0
GATE_MIN_RELIABILITY=70.0

# Optional: Ollama for real local model inference
# OLLAMA_BASE_URL=http://ollama:11434

# Optional: API keys for real provider testing
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
